# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored. Never commit real keys.
#
# Server-only: do NOT prefix secrets with NEXT_PUBLIC_, or Next.js will send them to the browser.

# AI provider key, used only in server code (route handlers / server actions).
# Leave empty to run with mock generation.
AI_API_KEY=

# Set to "true" to force mock data/mock generation even when a key is present.
USE_MOCK_DATA=true
